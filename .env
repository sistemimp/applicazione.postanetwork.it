# =============================================================================
# Posta Network — .env per applicazione.postanetwork.it (Plesk)
# Generato: 10/04/2026
#
# Istruzioni:
#   1. Questo file è chiamato .txt per sicurezza — copialo in httpdocs/.env
#      (sovrascrivendo il precedente)
#   2. Su Plesk: File Manager → httpdocs → .env → Edit → sostituisci tutto il
#      contenuto con questo → Save
#   3. Node.js → Restart App
#   4. Verifica https://applicazione.postanetwork.it/status → deve dare "ok"
#   5. Login: admin / Adm1n!@P0staN3tw0rk  (oppure admin1 / 1234567890123)
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://applicazione.postanetwork.it

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=10b3726bda8b5e30ae38f61145a7a126e8d2a482ad00de359b55de7ba2553528
JWT_REFRESH_SECRET=1c65f428d6c43f388ca8926aab37c2468f369be7c949e0a911988b8f5fb59009
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── Database TRACK (utenti, esiti, devices, config) ────────────────
DB_TRACK_HOST=localhost
DB_TRACK_PORT=3306
DB_TRACK_USER=PostaNetworkTrack
DB_TRACK_PASS=PostaNetworkTrack
DB_TRACK_NAME=postanetwork_track

# ── Database SPEDIZIONI ────────────────────────────────────────────
DB_SPED_HOST=localhost
DB_SPED_PORT=3306
DB_SPED_USER=PostaNetworkSpedizioni
DB_SPED_PASS=PostaNetworkSpedizioni
DB_SPED_NAME=postanetwork_spedizioni

# ── Database EXTERNAL (gestionale — sync bidirezionale) ────────────
EXTERNAL_SYNC_ENABLED=true
DB_EXT_HOST=localhost
DB_EXT_PORT=3306
DB_EXT_USER=ticketpn
DB_EXT_PASS=T1ck3tPostaNetw0rk
DB_EXT_NAME=ticket_test_postanetwork

# ── Pool connessioni ───────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
