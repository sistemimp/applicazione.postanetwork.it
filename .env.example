# =============================================================================
# Posta Network — .env template
# Copia questo file in .env e compila i valori reali PRIMA di lanciare il server.
# NON committare mai .env reale in git.
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://nuovo-dominio.it,https://www.nuovo-dominio.it

# ── JWT (GENERARE stringhe random di almeno 32 caratteri) ──────────
# Per generarle: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIARE_con_stringa_casuale_almeno_32_caratteri
JWT_REFRESH_SECRET=CAMBIARE_con_altra_stringa_casuale_32_caratteri
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# ── Database TRACK (esiti, users, devices, ecc.) ───────────────────
DB_TRACK_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_TRACK_PORT=4000
DB_TRACK_USER=ESEMPIO.root
DB_TRACK_PASS=CAMBIARE
DB_TRACK_NAME=postanetwork_track

# ── Database SPEDIZIONI (spedizioni separate) ──────────────────────
DB_SPED_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_SPED_PORT=4000
DB_SPED_USER=ESEMPIO.root
DB_SPED_PASS=CAMBIARE
DB_SPED_NAME=postanetwork_spedizioni

# ── Database EXTERNAL (gestionale — RICHIESTO) ─────────────────────
# Sync live bidirezionale con il gestionale esterno: quando crei, modifichi
# o elimini utenti dal pannello admin, e quando i postini registrano esiti
# dall'app mobile, le modifiche vengono propagate automaticamente a questo DB.
#
# Gli utenti del seed hanno già il loro external_user_id mappato — punta questo
# blocco al gestionale corretto e il sync riparte automaticamente.
#
# Se vuoi temporaneamente disabilitare il sync, imposta EXTERNAL_SYNC_ENABLED=false
# (il mapping resta ma non vengono fatte più chiamate di scrittura al DB esterno).
EXTERNAL_SYNC_ENABLED=true
DB_EXT_HOST=indirizzo.del.nuovo.gestionale
DB_EXT_PORT=3306
DB_EXT_USER=CAMBIARE
DB_EXT_PASS=CAMBIARE
DB_EXT_NAME=CAMBIARE

# ── Pool connessioni (default sensati) ─────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Feature flags opzionali ────────────────────────────────────────
# Per attivare il backup automatico, configurarlo dal pannello admin
